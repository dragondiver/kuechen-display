[Unit]
Description=Küchen-Display: Kameradienst für Handgesten (kuechen-display#2)
After=kuechen-dienst.service

[Service]
Type=simple
User=florian
WorkingDirectory=/home/florian/kuechen-display/gesten
ExecStart=/home/florian/gesten-venv/bin/python /home/florian/kuechen-display/gesten/gesten.py
Restart=on-failure
RestartSec=5

# Bewusst ohne [Install]: Die Kamera läuft nur, wenn man den Dienst von Hand startet
# (Festlegung 8.11.2026, Kamera nur beim Testen).
