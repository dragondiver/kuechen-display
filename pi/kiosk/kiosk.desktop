[Desktop Entry]
Type=Application
Name=Küchen-Display Kiosk
Comment=Ruhebildschirm im Chromium-Kiosk (kuechen-display#15)
Exec=sh -c 'sleep 8; exec chromium --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic --ozone-platform=wayland --touch-events=enabled --overscroll-history-navigation=0 --app=http://localhost:8080/'
X-GNOME-Autostart-enabled=true
